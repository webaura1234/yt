# Required: Gemini is the default provider for both script/title/description
# generation and TTS voiceover.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

PEXELS_API_KEY=<YOUR_PEXELS_API_KEY>
ASSEMBLY_AI_API_KEY=<YOUR_ASSEMBLY_AI_API_KEY>

# Optional: only used as a fallback for text generation if Gemini fails. Leave
# unset to run on Gemini alone.
OPENAI_API_KEY_AUTO_YT_SHORTS=<YOUR_OPENAI_API_KEY>

CRON_SCHEDULE="0 12 * * *"
RUN_ONCE="false"
VIDEO_COUNT="1"