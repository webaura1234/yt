{
  "name": "auto-yt-shorts dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Dashboard", "onAutoForward": "openPreview" },
    // The browser never talks to 8000 directly - the Next server proxies
    // /api and /media to it (see web/next.config.ts) - so it stays private
    // and unannounced. Forwarded anyway so you can curl it from a terminal.
    "8000": { "label": "Dashboard API", "onAutoForward": "silent" }
  },

  "containerEnv": {
    // Empty (not unset) makes the frontend use same-origin URLs, which the
    // Next rewrites forward to the API. In a Codespace the browser is on a
    // *.app.github.dev host where "localhost:8000" would resolve to the
    // user's own machine, so the default direct-to-localhost wiring can't work.
    "NEXT_PUBLIC_API_URL": ""
  },

  // Install on create so the first start is fast; run.sh then skips installing.
  "postCreateCommand": "pip install --user -r requirements-dev.txt && cd web && npm install --no-audit --no-fund",
  "postAttachCommand": "./run.sh --no-install",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"]
    }
  }
}
